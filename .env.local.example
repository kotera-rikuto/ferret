# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (採点・Embedding)
OPENAI_API_KEY=

# Resend (認証メールの送信)
#
# アプリのコードはこの値を読まない。認証メールを送るのは Supabase なので、
# 同じキーを Supabase 管理画面の SMTP 設定（Authentication → SMTP Settings）の
# パスワード欄に入れる。ここに置いてあるのは控え。
# grep しても参照箇所が出てこないのは正常。手順は tasks/C1 の作業記録。
RESEND_API_KEY=

# アプリURL
NEXT_PUBLIC_APP_URL=

# E2E（playwright.config.ts が .env.local から読む）
# 実際にログインさせるので、本番ユーザーではなく検証用アカウントを使うこと
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
