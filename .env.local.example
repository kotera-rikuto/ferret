# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (採点・Embedding)
OPENAI_API_KEY=

# Resend (認証メールの送信)
#
# アプリのコードはこの値を読まない。認証メールを送るのは Supabase なので、
# 同じキーを Supabase 管理画面の SMTP 設定（Authentication → SMTP Settings）の
# パスワード欄に入れる。ここに置いてあるのは控え。
# grep しても参照箇所が出てこないのは正常。手順は tasks/C1 の作業記録。
RESEND_API_KEY=

# アプリURL
NEXT_PUBLIC_APP_URL=

# 開発用アカウント（アプリのコードはこの値を読まない）
#
# ブラウザで動作確認するときに使うアカウント。手で入力するための控えを置く場所。
# **ここに書くのは .env.local だけ。** ドキュメントには絶対に書かない
# （リポジトリが Public。2026-08-22・C5 で TASKS.md と tasks/README.md から消した）。
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# E2E（playwright.config.ts が .env.local から読む）
#
# **どちらも任意。空でよい。** 未設定なら e2e@ferret.test を使い、
# パスワードは特権キーから導出する（tests/support/password.ts）。
# 以前はコードに既定値が平文で入っていて、それが公開されていた（2026-08-22・C5）。
# 別のアカウントで走らせたいときだけ、ここに書く
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
