# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (採点・Embedding)
OPENAI_API_KEY=

# AI採点の1日あたりの上限（D1・どちらも任意）
#
# **空でよい。** 未設定なら lib/ai/quota.ts の既定値（1人1日20問 / 全体1日500回）が効く。
# 値が壊れていたら（0以下・数字でない）既定値に落ちる ── 設定ミスで上限が消えないように。
#
# 上げたくなるのは利用者が増えたとき。**全体のほうを上げ忘れると全員が
# 「採点が混み合っています」になる**（発動は Vercel のログに出る）。
# NEXT_PUBLIC_ は付けないこと（画面には値を直書きせず、サーバーから渡している）。
#
# ⚠️ **これは金額の天井ではない。** 本当の天井は OpenAI 管理画面の使用量上限のほうで、
# そちらは残タスク.md §C-4 の宿題。
AI_SCORING_DAILY_LIMIT=
AI_SCORING_DAILY_LIMIT_GLOBAL=

# Resend (メールの送信)
#
# 2つの経路で使う。
# 1. 認証メール（確認・再設定）: 送るのは Supabase。同じキーを Supabase 管理画面の
#    SMTP 設定（Authentication → SMTP Settings）のパスワード欄に入れる。手順は tasks/C1。
# 2. 改善要望の通知（E13）: アプリのコード（lib/mail.ts）がこの値を読んで
#    作者あてにメールを送る。未設定でも意見は DB に残る（通知が飛ばないだけ）。
RESEND_API_KEY=

# 改善要望（作者へのメッセージ・E13）の届け先。
# 個人のアドレスなのでコードに直書きしない（リポジトリが Public）。
# 未設定でも意見は DB（problem_feedback）に残る。Vercel にも同じ値を入れること。
FEEDBACK_NOTIFY_EMAIL=

# アプリURL
NEXT_PUBLIC_APP_URL=

# 開発用アカウント（アプリのコードはこの値を読まない）
#
# ブラウザで動作確認するときに使うアカウント。手で入力するための控えを置く場所。
# **ここに書くのは .env.local だけ。** ドキュメントには絶対に書かない
# （リポジトリが Public。2026-08-22・C5 で TASKS.md と tasks/README.md から消した）。
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# E2E（playwright.config.ts が .env.local から読む）
#
# **どちらも任意。空でよい。** 未設定なら e2e@ferret.test を使い、
# パスワードは特権キーから導出する（tests/support/password.ts）。
# 以前はコードに既定値が平文で入っていて、それが公開されていた（2026-08-22・C5）。
# 別のアカウントで走らせたいときだけ、ここに書く
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
